---
import Layout from "./Layout.astro";
import Tags from "../components/Tags.astro";
import { formatDate } from "../utils/posts";

const { frontmatter, slug } = Astro.props;
---
<Layout title={`${frontmatter.title} | Oscar Lugo`} description={frontmatter.description}>
	<article class="post flex flex-col gap-y-10 justify-center items-center px-5 md:px-0 my-24 md:my-28 w-11/12 md:w-3/4 text-[#5FCDD9] border border-gray-600 rounded-lg py-5 mx-auto md:ml-5 shadow-lg shadow-gray-600">
		<img transition:name={slug} class="aspect-video w-11/12 md:w-3/4 rounded" src={frontmatter.image.url} alt={frontmatter.image.alt}>
		<header class="flex flex-col items-center gap-2 text-center w-11/12">
			<h1 class="text-2xl md:text-3xl text-[#5FCDD9] font-semibold text-balance">{frontmatter.title}</h1>
			<time class="text-sm text-gray-400" datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate)}</time>
		</header>
		<slot />
	</article>
	<Tags />
</Layout>
<style is:global>
	.post h2, .post h3{
		color: #5FCDD9;
		text-align: left;
		width: 80%;
		font-weight: 600;
	}
	.post h2{
		font-size: 1.5rem;
	}
	.post h3{
		font-size: 1.2rem;
	}
	.post ul{
		list-style: circle;
		width: 80%;
		padding-left: 1.5rem;
		text-align: left;
		color: #CBD5E1;
	}
	.post pre{
		width: 80%;
		max-width: 90%;
		padding: 1rem;
		border-radius: 0.5rem;
	}
	.post a{
		text-decoration: underline;
	}
	.post :not(pre) > code{
		color: #04BFAD;
	}
</style>
