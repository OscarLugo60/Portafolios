---
interface Props {
	description: string;
	title: string;
}

const {description, title } = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/urbanist';
import { ViewTransitions } from 'astro:transitions';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/img/Avatar.webp" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>
		<ViewTransitions />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4VQKQL0E1N"></script>
		<script type="text/javascript">
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-4VQKQL0E1N');
		</script>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<script>
			import { initFlowbite } from 'flowbite';
			// Flowbite se inicializa solo al cargar; tras una View Transition hay que reiniciarlo
			document.addEventListener('astro:after-swap', () => initFlowbite());
		</script>
	</body>
</html>
<style is:global>
	html {
		font-family: 'Urbanist', system-ui, sans-serif;
		scroll-behavior: smooth !important;
		/* Deja espacio para el header fijo al saltar a una sección */
		scroll-padding-top: 5rem;
	}
	body{
		background-color: #172026;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	#index{
		background-image: url('/img/background-laptop2.webp');
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}
	#contact{
		background-image: url('/img/2968880.webp');
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}
	p{
		width: 80%;
		color: #CBD5E1;
	}
	@media(prefers-reduced-motion: reduce){
		html{
			scroll-behavior: auto;
		}
	}
</style>
