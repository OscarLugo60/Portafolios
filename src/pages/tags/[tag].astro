---
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../components/BlogPost.astro';
import Tags from '../../components/Tags.astro';
import { getSortedPosts, getUniqueTags, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
    const allPost = await getSortedPosts();

    return getUniqueTags(allPost).map((tag) => ({
        params: { tag: tagSlug(tag) },
        props: { tag, posts: allPost.filter((post) => post.data.tags.includes(tag)) },
    }));
}

const { tag, posts } = Astro.props;
---
<Layout title={`Artículos sobre ${tag} | Oscar Lugo`}
    description={`Artículos de Oscar Lugo sobre ${tag}`}>
    <div class="flex flex-col gap-y-10 justify-center items-center text-center px-5 md:px-0 my-24 md:my-28 w-full md:w-4/5 m-auto">
        <h1 class="text-2xl md:text-5xl text-[#5FCDD9] font-semibold flex flex-col">Artículos sobre: <span>{tag}</span></h1>
        <div class="flex gap-y-10 justify-center items-center text-center px-5 md:px-0">
            <div class="grid grid-cols-1 gap-10 justify-items-center">
                {posts.map((post) => <BlogPost title={post.data.title} description={post.data.description} url={`/posts/${post.slug}/`} image={post.data.image} pubDate={post.data.pubDate} slug={post.slug}/>)}
            </div>
                <Tags />
        </div>
    </div>
</Layout>
