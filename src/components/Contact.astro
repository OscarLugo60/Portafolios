---

<form id="form" class="flex flex-col gap-y-5 justify-center items-center">
    <div class="md:mb-6 md:min-w-96">
        <label for="email" class="block mb-2 text-sm font-medium text-[#5FCDD9]">Correo Electrónico</label>
        <input type="email" id="email" name="email" class="bg-[#027373] border border-[#5FCDD9] text-white text-xs md:text-sm rounded-md focus:ring-[#04BF9D] focus:border-[#04BF9D] block w-full p-2.5 placeholder-gray-300 " placeholder="correo@dominio.com" required>
    </div>
    <div class="md:mb-6 md:min-w-96">
        <label for="name" class="block mb-2 text-sm font-medium text-[#5FCDD9]">Nombre</label>
        <input type="text" id="name" name="name" class="bg-[#027373] border border-[#5FCDD9] text-white text-xs md:text-sm rounded-md focus:ring-[#04BF9D] focus:border-[#04BF9D] block w-full p-2.5 placeholder-gray-300" placeholder="Tu nombre" required>
    </div>
    <div class="md:mb-6 md:min-w-96 min-h-28">
        <label for="message" class="block mb-2 text-sm font-medium text-[#5FCDD9]">Mensaje</label>
        <textarea id="message" name="message" rows="4" required class="block w-full h-full p-4 text-white border border-[#5FCDD9] rounded-md bg-[#027373] text-xs md:text-sm focus:ring-[#04BF9D] focus:border-[#04BF9D]"></textarea>
    </div>
    <input type="submit" id="button" value="Enviar" class="text-white bg-[#027373] hover:bg-[#038484] focus:ring-4 focus:ring-[#04BF9D] font-medium rounded-md text-sm px-5 py-2.5 me-2 mb-2">
</form>
<script>

    import emailjs from '@emailjs/browser';
    emailjs.init('Anh6_eXZZm5wASyGM')

    const btn = document.getElementById('button') as HTMLInputElement;

    document.getElementById('form')
    .addEventListener('submit', function(event) {
    event.preventDefault();

    const formElement = this as HTMLFormElement;

    btn.value = 'Enviando...';
    btn.disabled = true;

    const serviceID = 'default_service';
    const templateID = 'template_xkghjos';

    emailjs.sendForm(serviceID, templateID, formElement)
        .then(() => {
        btn.value = 'Enviar';
        btn.disabled = false;
        formElement.reset();
        alert('¡Mensaje enviado! Te responderé pronto.');
        }, (err) => {
        btn.value = 'Enviar';
        btn.disabled = false;
        console.error(err);
        alert('No se pudo enviar el mensaje. Inténtalo de nuevo o escríbeme a oscarlugo60@gmail.com');
        });
    });
</script>
