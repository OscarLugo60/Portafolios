---
interface Props{
    title: string
    subtitle: string
    description: string
    achievements?: string[]
    date: string
}
 const { title, subtitle, description, achievements = [], date } = Astro.props
---

<div class="absolute w-4 h-4 bg-[#027373] rounded-full mt-1.5 -start-[9px] border border-[#027373]"></div>
<time class="mb-1 text-sm font-normal leading-none text-[#5FCDD9]">{date}</time>
<h3 class="text-lg font-semibold text-[#04BFAD]">{title}</h3>
<h4 class="text-md font-semibold text-[#04BFAD]">{subtitle}</h4>
<p class="mb-2 text-base font-normal text-gray-400">{description}</p>
{achievements.length > 0 && (
    <ul class="mb-4 ms-4 list-disc space-y-1 text-base text-gray-300 marker:text-[#04BFAD]">
        {achievements.map(item => <li>{item}</li>)}
    </ul>
)}
