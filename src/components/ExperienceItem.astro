---
interface Props{
    title: string
    subtitle: string
    description: string
    link?: string
    date: string
}
 const { title, subtitle, description, link, date } = Astro.props
---

<div class="absolute w-4 h-4 bg-[#027373] rounded-full mt-1.5 -start-[9px] border border-[#027373]"></div>
<time class="mb-1 text-sm font-normal leading-none text-[#5FCDD9] dark:text-gray-400">{date}</time>
<h3 class="text-lg font-semibold text-[#04BFAD] dark:text-white">{title}</h3>
<h4 class="text-md font-semibold text-[#04BFAD] dark:text-white">{subtitle}</h4>
<p class="mb-4 text-base font-normal text-gray-400 dark:text-gray-400">{description}</p>
