---
import ProjectItem from "./ProjectItem.astro";
const PROJECT = [
    {
        id: 1,
        title: 'Sistema de Control de Cirugías',
        description:
            'Aplicación web para organizar las cirugías de una clínica con varios quirófanos y cirujanos. Registra cada intervención con su fecha, hora, cirujano y quirófano, administra los implementos quirúrgicos y muestra estadísticas en gráficas. Redujo los errores de organización en un 80% y mejoró la planificación de las cirugías. Trabajé en el backend con Python y Django, la base de datos en PostgreSQL y el despliegue con Nginx.',
        img: [
            'img/ControlCirugias/Login.webp',
            'img/ControlCirugias/Cirugias.webp',
            'img/ControlCirugias/Graficas.webp',
            'img/ControlCirugias/Registro.webp',
        ],
        tech: ['Python', 'Django', 'JavaScript', 'PostgreSQL', 'Nginx']
    },
    {
        id: 4,
        title: 'Sistema de Gestión de Estadías de Pacientes',
        description:
            'Sistema para que los pacientes hospitalizados reporten inconvenientes durante su estadía y el personal los atienda, consulten información importante sobre su estadía y valoren la atención recibida. Permitió que el personal resolviera los reportes un 50% más rápido.',
    },
    {
        id: 2,
        title: 'Gestor de Tareas Administrativas',
        description:
            'Aplicación web progresiva (PWA) para que una empresa asigne tareas a sus gerentes, las organice por departamento y mida su cumplimiento con gráficas de rendimiento. Backend en Django con MySQL e interfaz en Svelte.',
        github: 'https://github.com/OscarLugo60/work_app',
        img: [
            'img/Tareas/Login.webp',
            'img/Tareas/ListaTareas.webp',
            'img/Tareas/CrearTarea.webp',
            'img/Tareas/DepartamentosUsuarios.webp',
            'img/Tareas/Opciones.webp',
            'img/Tareas/Graficas.webp',
        ],
        tech: ['Python', 'Django', 'JavaScript', 'MySQL', 'Svelte', 'Bootstrap' ]
    },
    {
        id: 3,
        title: 'Desarrollo de Páginas Web',
        description:
            'Sitios web para las clínicas Centro Médico Docente el Paso y Policlínica Altos Mirandinos, construidos con Astro y Tailwind. Incluyen un directorio médico conectado a una API en Django que permite buscar doctores al instante, sin recargar la página.',
        links: [
            { label: 'Centro Médico Docente El Paso', url: 'https://centromedicodocenteelpaso.com/' },
            { label: 'Policlínica Altos Mirandinos', url: 'https://policlinicaaltosmirandinos.com/' },
        ],
        github: 'https://github.com/OscarLugo60/web-cmdep',
        img: [
            'img/PaginaWeb/InicioCMDEP.webp',
            'img/PaginaWeb/DirectorioMedico.webp',
            'img/PaginaWeb/QuienesSomos.webp',
            'img/PaginaWeb/Contacto.webp',
            'img/PaginaWeb/Servicios.webp',
        ],
        tech: ['Python', 'Django', 'JavaScript', 'PostgreSQL', 'Astro', 'Tailwind']
    },
]
---
<ol class="relative mt-5 border-s border-[#027373]">
    {
        PROJECT.map(project => (
            <li class="mb-10 ms-4 list-none">
                <ProjectItem {... project} />
            </li>
        ))
    }               
</ol>