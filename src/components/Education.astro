---
const EDUCATION = [
    {
        title: 'Ingeniería en Informática',
        place: 'Universidad Politécnica Territorial de los Altos Mirandinos "Cecilio Acosta"',
        year: '2021',
    },
    {
        title: 'Técnico Superior en Informática',
        place: 'Universidad Politécnica Territorial de los Altos Mirandinos "Cecilio Acosta"',
        year: '2018',
    },
]

const COURSES = [
    { title: 'Curso de iniciación al desarrollo con IA', place: 'Big School', year: '2025' },
    { title: 'Técnico en Electrónica', place: 'Instituto Simón Bolívar', year: '2016' },
    { title: 'Soporte Técnico y Reparación de Micro', place: 'Instituto Simón Bolívar', year: '2013' },
]

const LANGUAGES = [
    { name: 'Español', level: 'Nativo' },
    { name: 'Inglés', level: 'B1 (intermedio)' },
]
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full">
    <section class="flex flex-col gap-4">
        <h3 class="text-xl text-[#5FCDD9] font-semibold">Formación académica</h3>
        <ul class="flex flex-col gap-4 list-none">
            {EDUCATION.map(item => (
                <li>
                    <h4 class="text-base font-semibold text-[#04BFAD]">{item.title}</h4>
                    <p class="w-full text-sm text-gray-400">{item.place} · {item.year}</p>
                </li>
            ))}
        </ul>
    </section>
    <section class="flex flex-col gap-4">
        <h3 class="text-xl text-[#5FCDD9] font-semibold">Cursos y certificaciones</h3>
        <ul class="flex flex-col gap-4 list-none">
            {COURSES.map(item => (
                <li>
                    <h4 class="text-base font-semibold text-[#04BFAD]">{item.title}</h4>
                    <p class="w-full text-sm text-gray-400">{item.place} · {item.year}</p>
                </li>
            ))}
        </ul>
    </section>
    <section class="flex flex-col gap-4">
        <h3 class="text-xl text-[#5FCDD9] font-semibold">Idiomas</h3>
        <ul class="flex flex-col gap-4 list-none">
            {LANGUAGES.map(item => (
                <li>
                    <h4 class="text-base font-semibold text-[#04BFAD]">{item.name}</h4>
                    <p class="w-full text-sm text-gray-400">{item.level}</p>
                </li>
            ))}
        </ul>
    </section>
</div>
