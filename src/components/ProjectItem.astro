---
import GitHub from '../icons/GitHub.astro'
import PythonIcon from '../icons/PythonIcon.astro'
import DjangoIcon from '../icons/DjangoIcon.astro'
import JSIcon from '../icons/JSIcon.astro'
import MySQLIcon from '../icons/MySQL.astro'
import PostgreSQLIcon from '../icons/Postgres.astro'
import BootstrapIcon from '../icons/Bootstrap.astro'
import TailwindIcon from '../icons/TailwindIcon.astro'
import AstroIcon from '../icons/AstroIcon.astro'
import NginxIcon from '../icons/NginxIcon.astro'
import SvelteIcon from '../icons/SvelteIcon.astro'
import WebIcon from '../icons/WebIcon.astro'

interface Props{
    id: number
    title: string
    description: string
    link?: string
    img?: string[]
    tech?: string[]
    github?: string
}
const { id, title, description, link, img = [], github, tech = [] } = Astro.props
const hasDetails = img.length > 0 || tech.length > 0 || link || github

const TECH_ICONS = {
    Python: PythonIcon,
    Django: DjangoIcon,
    JavaScript: JSIcon,
    MySQL: MySQLIcon,
    PostgreSQL: PostgreSQLIcon,
    Bootstrap: BootstrapIcon,
    Tailwind: TailwindIcon,
    Astro: AstroIcon,
    Nginx: NginxIcon,
    Svelte: SvelteIcon,
}
---

<div class="absolute w-4 h-4 bg-[#027373] rounded-full mt-1.5 -start-[9px] border border-[#027373]"></div>
<h3 class="text-lg font-semibold text-[#04BFAD]">{title}</h3>
<p class="mb-4 text-base font-normal text-gray-400">{description}</p>
{hasDetails && (<>
<button
    data-dialog-open={`project-${id}`}
    type="button"
    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[#027373] border border-[#04BF9D] rounded-lg hover:bg-[#172026] hover:text-[#04BF9D] focus:outline-none focus:ring-4 focus:ring-[#04BF9D] transition"
>
    Saber más
    <svg class="w-3 h-3 ms-2" aria-hidden="true" fill="none" viewBox="0 0 14 10">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
    </svg>
</button>

<dialog id={`project-${id}`} aria-labelledby={`project-${id}-title`} class="project-dialog w-full max-w-2xl p-0 bg-[#172026] rounded-lg shadow-xl">
    <div class="flex items-center justify-between p-3 border-b border-gray-600">
        <h3 id={`project-${id}-title`} class="text-xl font-semibold text-white">{title}</h3>
        <button type="button" data-dialog-close class="text-gray-400 hover:bg-gray-600 hover:text-white rounded-lg w-8 h-8 inline-flex justify-center items-center">
            <svg class="w-3 h-3" aria-hidden="true" fill="none" viewBox="0 0 14 14">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
            </svg>
            <span class="sr-only">Cerrar</span>
        </button>
    </div>

    <div class="p-3 space-y-4 flex flex-col">
        {img.length > 0 && (
            <div class="relative w-full" data-carousel>
                <div class="relative h-56 md:h-96 overflow-hidden rounded-lg bg-[#0d1316]">
                    {img.map((item, index) => (
                        <img
                            src={`/${item}`}
                            alt={`${title} - captura ${index + 1}`}
                            loading="lazy"
                            class:list={['absolute inset-0 w-full h-full object-contain transition-opacity duration-500', index === 0 ? 'opacity-100' : 'opacity-0']}
                            data-carousel-item
                        >
                    ))}
                </div>
                <div class="absolute z-10 flex -translate-x-1/2 gap-3 bottom-4 left-1/2">
                    {img.map((_, index) => (
                        <button type="button" class:list={['w-3 h-3 rounded-full', index === 0 ? 'bg-white' : 'bg-white/40']} aria-label={`Ver imagen ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'} data-carousel-dot={index}></button>
                    ))}
                </div>
                <button type="button" class="absolute top-0 start-0 z-10 flex items-center justify-center h-full px-3 group focus:outline-none" data-carousel-prev>
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 group-hover:bg-white/50 group-focus:ring-4 group-focus:ring-white">
                        <svg class="w-4 h-4 text-white" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4"/>
                        </svg>
                        <span class="sr-only">Anterior</span>
                    </span>
                </button>
                <button type="button" class="absolute top-0 end-0 z-10 flex items-center justify-center h-full px-3 group focus:outline-none" data-carousel-next>
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 group-hover:bg-white/50 group-focus:ring-4 group-focus:ring-white">
                        <svg class="w-4 h-4 text-white" aria-hidden="true" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="sr-only">Siguiente</span>
                    </span>
                </button>
            </div>
        )}

        {tech.length > 0 && (
            <div class="flex flex-col items-center justify-center">
                <h4 class="mb-2 text-xl font-bold tracking-tight text-[#5FCDD9]">Tecnologías</h4>
                <ul class="flex flex-wrap gap-3 items-center justify-center list-none">
                    {tech.map(item => {
                        const Icon = TECH_ICONS[item]
                        return Icon
                            ? <li title={item}><Icon class={item === 'Python' ? 'size-8' : 'size-6'} /><span class="sr-only">{item}</span></li>
                            : <li class="text-xs text-[#04BFAD] border border-[#027373] rounded px-2 py-1">{item}</li>
                    })}
                </ul>
            </div>
        )}
    </div>

    {(link || github) && (
        <div class="flex items-center gap-3 p-3 border-t border-gray-600">
            {link && (
                <a href={link} target="_blank" rel="noopener" class="text-white bg-[#027373] hover:bg-[#04BFAD] font-medium rounded-lg text-sm px-5 py-2 transition flex items-center justify-center gap-3">
                    <WebIcon class="size-6 text-[#5FCDD9]" />
                    Visitar sitio
                </a>
            )}
            {github && (
                <a href={github} target="_blank" rel="noopener" class="text-white bg-[#027373] hover:bg-[#04BF9D] font-medium rounded-lg text-sm px-5 py-2 transition flex items-center justify-center gap-3">
                    <GitHub class="size-6 text-[#5FCDD9]"/>
                    Ver GitHub
                </a>
            )}
        </div>
    )}
</dialog>
</>)}

<style is:global>
    .project-dialog::backdrop {
        background: rgb(0 0 0 / 0.7);
    }
</style>

<script>
    // Se vuelve a enlazar en cada navegación porque las View Transitions reemplazan el contenido
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach(button => {
            const dialog = document.getElementById(button.dataset.dialogOpen!) as HTMLDialogElement | null
            if (!dialog) return
            button.addEventListener('click', () => dialog.showModal())
            dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close())
            // Cerrar al hacer clic fuera del contenido
            dialog.addEventListener('click', event => {
                if (event.target === dialog) dialog.close()
            })
        })

        document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(carousel => {
            const items = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-item]')]
            const dots = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-dot]')]
            let current = 0

            const show = (index: number) => {
                current = (index + items.length) % items.length
                items.forEach((item, i) => {
                    item.classList.toggle('opacity-100', i === current)
                    item.classList.toggle('opacity-0', i !== current)
                })
                dots.forEach((dot, i) => {
                    dot.classList.toggle('bg-white', i === current)
                    dot.classList.toggle('bg-white/40', i !== current)
                    dot.setAttribute('aria-current', String(i === current))
                })
            }

            carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => show(current - 1))
            carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => show(current + 1))
            dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)))
        })
    })
</script>
