---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
    {
        date: 'Noviembre 2021 - Actualidad',
        title: 'Coordinador del departamento de sistemas',
        subtitle: 'Centro Médico Docente el Paso',
        description:
            'Responsable del área de sistemas de la clínica: administración y mantenimiento de servidores, configuración de redes y soporte y reparación de equipos informáticos.',
        link: '#',
    },
    {
        date: 'Agosto 2021',
        title: 'Desarrollador Backend',
        subtitle: 'Empresas Grupo el Paso',
        description:
            'Parte del equipo que desarrolló el sistema de control de cirugías para una clínica con varios quirófanos y cirujanos, a cargo del backend en Python y Django.',
        link: '#',
    },
]
---
<ol class="relative border-s-2 border-[#027373] dark:border-gray-700 mt-5">
    {
        EXPERIENCE.map(experience => (
            <li class="mb-10 ms-4">
                <ExperienceItem {... experience} />
            </li>
        ))
    }               
</ol>

